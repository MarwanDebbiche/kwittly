{
  "name": "kwittly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint",
    "dev:backend": "convex dev",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json --noEmit",
    "deploy:dev": "CLOUDFLARE_ENV=dev npm run build && wrangler deploy",
    "preview": "vite preview",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract && lingui compile --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:all": "convex dev --start 'npm run dev'"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/resend": "^0.2.8",
    "@lingui/core": "^6.8.0",
    "@lingui/react": "^6.8.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "better-auth": "~1.6.15",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@edge-runtime/vm": "^5.0.0",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
